# Optional HTTP configuration for acquisition scripts.
# Copy to .env and customize if needed. .env is gitignored.

# Custom User-Agent (default: UVA-MSBA-Capstone-Research/1.0)
# HTTP_USER_AGENT=UVA-MSBA-Capstone-Research/1.0 (your-contact@example.edu)

# Proxy, if you're behind one
# HTTP_PROXY=http://proxy.example.com:8080
# HTTPS_PROXY=http://proxy.example.com:8080
