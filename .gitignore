# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
.pytest_cache/
.ruff_cache/

# --- Virtual environments ---
.venv/
venv/
env/
ENV/
.env

# --- OS/IDE ---
.DS_Store
.vscode/
.idea/
*.swp
*.swo

# --- Data (kept out of git; provenance preserved via manifests) ---
# File-pattern exclusions so negations below actually apply (git can't
# re-include files inside a directory matched by a directory-level rule).
data/raw/**/*.zip
data/raw/**/*.zip.part
data/raw/**/*.csv
data/raw/**/*.csv.gz
data/raw/**/*.tsv
data/raw/**/*.txt
data/raw/**/*.json
data/raw/**/*.jsonl
data/raw/**/*.xml
data/raw/**/*.xls
data/raw/**/*.xlsx
data/raw/**/*.mdb
data/raw/**/*.dat
data/raw/**/*.parquet
data/processed/**/*.parquet
data/processed/**/*.csv
data/processed/**/*.jsonl
data/features/**/*.parquet
data/features/**/*.csv
data/features/**/*.npy

# --- But KEEP manifests and summary logs ---
!data/raw/**/manifest.json
!data/raw/ACQUISITION_LOG.md
!data/processed/**/*_stats.md
!data/features/**/*_stats.md

# --- Keep .gitkeep placeholders ---
!data/raw/.gitkeep
!data/processed/.gitkeep
!data/features/.gitkeep

# --- Models and figures ---
models/checkpoints/
# reports/ is intentionally tracked — it's the capstone deliverable
